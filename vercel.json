{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"feature/ai-analysis-1\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"feature/pilot-first-impression-1\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"feature/scam-quality-1.2\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"feature/hybrid-consent-1.4\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"feature/scam-quality-1.5\" ]",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
