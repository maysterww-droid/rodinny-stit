# RODINNÝ ŠTÍT 1.0 · proměnné prostředí serveru (/api/analyze)
# NIKDY sem nevkládejte skutečné hodnoty a soubor .env necommitujte.
# Hodnoty patří jen do Vercel → Project → Settings → Environment Variables, prostředí „Preview“, větev feature/ai-analysis-1.

AI_ENABLED=false                    # nouzový vypínač; true jen po schválení vlastníkem
AI_ALLOWED_VERCEL_ENVS=preview      # AI běží jen v Preview; Production zůstává vypnutá
OPENAI_API_KEY=                     # klíč samostatného OpenAI projektu s limitem útraty
OPENAI_MODEL=gpt-5.4-mini           # alternativa: gpt-6-luna (levnější; ověřit podporu structured outputs)
OPENAI_REASONING_EFFORT=low         # prázdné = parametr se neposílá
RATE_LIMIT_SALT=                    # náhodný řetězec ≥ 32 znaků (hash IP pro limity)

# Origin: na Vercel Preview stačí same-origin (výchozí). Cizí originy jen výslovně:
ALLOW_SAME_ORIGIN=true
ALLOWED_ORIGINS=

# Trvalé úložiště limitů – doplní integrace Upstash for Redis (KV_REST_API_URL / KV_REST_API_TOKEN)

# Tvrdé limity
MAX_CHARS=3000
MAX_TEXT_BYTES=6000
MAX_OUTPUT_TOKENS=1200              # strop vč. reasoning tokenů; kód nepovolí víc než 2000
PROMPT_OVERHEAD_TOKENS=500
PROVIDER_TIMEOUT_MS=20000
LIMIT_PER_IP_HOUR=5
LIMIT_PER_IP_DAY=15
LIMIT_GLOBAL_DAY=200
DAILY_BUDGET_USD=1
MONTHLY_BUDGET_USD=5

# Ceny: pro známé modely jsou vestavěné; tyto proměnné je mohou jen zvýšit. Pro jiný model jsou povinné.
PRICE_INPUT_PER_MTOK_USD=
PRICE_OUTPUT_PER_MTOK_USD=
