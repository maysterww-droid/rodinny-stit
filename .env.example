# RODINNÝ ŠTÍT 1.0 · proměnné prostředí serveru (/api/analyze)
# NIKDY sem nevkládejte skutečné hodnoty a soubor .env necommitujte. Hodnoty patří jen do nastavení hostingu (Vercel → Settings → Environment Variables).

AI_ENABLED=false                      # nouzový vypínač; true jen po schválení vlastníkem
OPENAI_API_KEY=                       # tajný klíč samostatného OpenAI projektu s nastaveným limitem útraty
OPENAI_MODEL=gpt-4.1-mini             # ověřit dostupnost a cenu v aktuální dokumentaci
ALLOWED_ORIGINS=https://maysterww-droid.github.io
PREVIEW_TOKEN=                        # vyplněno = jen uzavřené testování (hlavička X-Preview-Token, v pilotu ?preview=...)
RATE_LIMIT_SALT=                      # náhodný řetězec ≥ 32 znaků (hashování IP pro limity)

# Trvalé úložiště limitů (Upstash Redis / Vercel Marketplace Redis) – bez něj se AI nezapne
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limity a rozpočet (výchozí hodnoty)
MAX_CHARS=3000
MAX_OUTPUT_TOKENS=700
PROVIDER_TIMEOUT_MS=15000
LIMIT_PER_IP_HOUR=5
LIMIT_PER_IP_DAY=15
LIMIT_GLOBAL_DAY=300
DAILY_BUDGET_USD=1
PRICE_INPUT_PER_MTOK_USD=0.4          # ověřit v ceníku zvoleného modelu
PRICE_OUTPUT_PER_MTOK_USD=1.6
EST_INPUT_TOKENS=2500
